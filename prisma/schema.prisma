// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntrySource {
  manual
  habit
}

enum WorkspaceKind {
  private
  shared
}

enum WorkspaceMemberRole {
  owner
  member
}

enum WorkspaceInviteType {
  email
  open_link
}

enum EntryVisibility {
  private
  workspace
}

enum EntryMode {
  spent
  avoided
}

enum EntrySavingContext {
  none
  comparison
}

enum EntryPaymentMode {
  single_payer
  joint_account
}

enum HabitOccurrenceStatus {
  pending
  spent
  avoided
  skipped
}

model Category {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  color        String?
  icon         String?
  isDefault    Boolean       @default(false)
  archivedAt   DateTime?
  entries      Entry[]
  habits       Habit[]
  quickPresets QuickPreset[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workspaceId, slug])
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

model Entry {
  id                String           @id @default(cuid())
  workspaceId       String?
  workspace         Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title             String
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  realCost          Decimal          @db.Decimal(10, 2)
  alternativeCost   Decimal          @db.Decimal(10, 2)
  savedAmount       Decimal          @db.Decimal(10, 2)
  mode              EntryMode          @default(spent)
  savingContext     EntrySavingContext @default(none)
  paymentMode       EntryPaymentMode   @default(single_payer)
  date              DateTime
  isFirstEntryOfDay Boolean          @default(false)
  note              String?
  source            EntrySource      @default(manual)
  visibility        EntryVisibility  @default(workspace)
  beneficiaries     EntryBeneficiary[]
  createdByUserId   String?
  createdBy         User?            @relation("EntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paidByUserId      String?
  paidByUser        User?            @relation("EntryPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  habitOccurrenceId String?          @unique
  habitOccurrence   HabitOccurrence? @relation(fields: [habitOccurrenceId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([paidByUserId])
  @@index([workspaceId, date])
  @@index([workspaceId, categoryId, date])
  @@index([workspaceId, savedAmount, date])
}

model EntryBeneficiary {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([userId])
}

model Habit {
  id              String            @id @default(cuid())
  workspaceId     String?
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name            String
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount          Decimal           @db.Decimal(10, 2)
  activeDays      Json
  isActive        Boolean           @default(true)
  defaultBehavior String            @default("spent")
  targetScope     String            @default("self")
  targetUserId    String?
  targetUser      User?             @relation("HabitTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reminderEnabled Boolean           @default(false)
  reminderTime    String?
  occurrences     HabitOccurrence[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId])
  @@index([targetUserId])
}

model HabitOccurrence {
  id        String                @id @default(cuid())
  habitId   String
  habit     Habit                 @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  status    HabitOccurrenceStatus @default(pending)
  entry     Entry?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([habitId, date])
}

model Goal {
  id           String     @id @default(cuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title        String
  targetAmount Decimal    @db.Decimal(10, 2)
  emoji        String?
  targetUserId String?
  targetUser   User?      @relation("GoalTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
  @@index([targetUserId])
}

model QuickPreset {
  id              String     @id @default(cuid())
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title           String
  categoryId      String
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  realCost        Decimal    @db.Decimal(10, 2)
  alternativeCost Decimal    @db.Decimal(10, 2)
  note            String?
  targetUserId    String?
  targetScope     String?
  targetUser      User?      @relation("QuickPresetTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([workspaceId])
  @@index([targetUserId])
}

model User {
  id                   String            @id
  email                String?           @unique
  name                 String?
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]
  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreatedBy")
  workspaceInvitesAccepted WorkspaceInvite[] @relation("WorkspaceInviteAcceptedBy")
  createdEntries       Entry[]             @relation("EntryCreatedBy")
  paidEntries          Entry[]             @relation("EntryPaidBy")
  beneficiaryEntries   EntryBeneficiary[]
  targetHabits         Habit[]             @relation("HabitTargetUser")
  targetGoals          Goal[]              @relation("GoalTargetUser")
  targetPresets        QuickPreset[]       @relation("QuickPresetTargetUser")
  feedbacks            Feedback[]          @relation("FeedbackUser")
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  kind         WorkspaceKind     @default(private)
  timezone     String            @default("Europe/Rome")
  currency     String            @default("EUR")
  language     String            @default("it")
  ownerUserId  String
  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  categories   Category[]
  entries      Entry[]
  habits       Habit[]
  goals        Goal[]
  quickPresets QuickPreset[]
  feedbacks    Feedback[]        @relation("FeedbackWorkspace")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerUserId])
}

model Feedback {
  id          String    @id @default(cuid())
  userId      String?
  workspaceId String?
  type        String
  message     String
  route       String?
  userAgent   String?
  viewport    String?
  timezone    String?
  locale      String?
  displayMode String?
  appVersion  String?
  createdAt   DateTime  @default(now())

  user      User?      @relation("FeedbackUser", fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation("FeedbackWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([type])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(member)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvite {
  id                String     @id @default(cuid())
  tokenHash         String     @unique
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              WorkspaceInviteType @default(email)
  invitedEmail      String
  role              WorkspaceMemberRole @default(member)
  createdByUserId   String?
  createdBy         User?      @relation("WorkspaceInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedByUserId  String?
  acceptedBy        User?      @relation("WorkspaceInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt        DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime
  maxUses           Int        @default(1)
  usedCount         Int        @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([workspaceId])
  @@index([invitedEmail])
  @@index([expiresAt])
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, revokedAt])
}
