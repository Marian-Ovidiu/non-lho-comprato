// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntrySource {
  manual
  habit
  imported
}

enum WorkspaceKind {
  private
  shared
}

enum WorkspaceMemberRole {
  owner
  member
}

enum WorkspaceInviteType {
  email
  open_link
}

enum EntryVisibility {
  private
  workspace
}

enum EntryMode {
  spent
  avoided
}

enum EntrySavingContext {
  none
  comparison
}

enum EntryPaymentMode {
  single_payer
  joint_account
}

/// Le due sole direzioni che un giroconto puo' avere. Un enum invece di una
/// coppia origine/destinazione perche' cosi' "comune verso comune" e "mio
/// verso mio" non sono nemmeno scrivibili.
enum TransferDirection {
  to_joint
  to_personal
}

enum HabitOccurrenceStatus {
  pending
  spent
  avoided
  skipped
}

enum BudgetPeriod {
  weekly
  monthly
}

enum BudgetScope {
  workspace
  category
}

enum ImportSource {
  bank_csv
}

enum ImportBatchStatus {
  parsing
  ready
  partial
  completed
  failed
}

/// Da dove arriva un'entrata. Non riusa EntrySource perche' quello ha `habit`,
/// e un'abitudine ricorrente che produce entrate non esiste.
enum IncomeSource {
  manual
  imported
}

/// Il verso di una riga importata. Esiste perche' il parser lo sa e prima lo
/// buttava via: l'importo veniva salvato in valore assoluto, e da quel momento
/// un accredito era indistinguibile da un addebito.
enum ImportedTransactionFlow {
  outgoing
  incoming
}

enum ImportedTransactionStatus {
  pending
  confirmed
  ignored
  duplicate
  error
}

model Category {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  color        String?
  icon         String?
  isDefault    Boolean       @default(false)
  archivedAt   DateTime?
  entries      Entry[]
  habits       Habit[]
  budgets      Budget[]
  importedTransactionsSuggested ImportedTransaction[] @relation("ImportedTransactionCategorySuggested")
  importedTransactionsConfirmed ImportedTransaction[] @relation("ImportedTransactionCategoryConfirmed")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workspaceId, slug])
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

model Entry {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title             String
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  realCost          Decimal          @db.Decimal(10, 2)
  alternativeCost   Decimal          @db.Decimal(10, 2)
  savedAmount       Decimal          @db.Decimal(10, 2)
  mode              EntryMode          @default(spent)
  savingContext     EntrySavingContext @default(none)
  paymentMode       EntryPaymentMode   @default(single_payer)
  /// Canonical value: midnight of the entry's calendar day in the workspace
  /// timezone (see parseWorkspaceDateKey). Legacy rows may hold UTC midnight
  /// instead; both bucket to the same local day for UTC+ timezones.
  date              DateTime
  isFirstEntryOfDay Boolean          @default(false)
  note              String?
  source            EntrySource      @default(manual)
  visibility        EntryVisibility  @default(workspace)
  beneficiaries     EntryBeneficiary[]
  createdByUserId   String?
  createdBy         User?            @relation("EntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paidByUserId      String?
  paidByUser        User?            @relation("EntryPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  habitOccurrenceId String?          @unique
  habitOccurrence   HabitOccurrence? @relation(fields: [habitOccurrenceId], references: [id], onDelete: SetNull)
  importedTransactions ImportedTransaction[] @relation("ImportedTransactionEntry")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([paidByUserId])
  @@index([workspaceId, date])
  @@index([workspaceId, paidByUserId, date])
  @@index([workspaceId, categoryId, date])
  @@index([workspaceId, savedAmount, date])
}

model EntryBeneficiary {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([userId])
  @@index([userId, entryId])
}

model Habit {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount          Decimal           @db.Decimal(10, 2)
  activeDays      Json
  isActive        Boolean           @default(true)
  defaultBehavior String            @default("spent")
  targetScope     String            @default("self")
  targetUserId    String?
  targetUser      User?             @relation("HabitTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reminderEnabled Boolean           @default(false)
  reminderTime    String?
  occurrences     HabitOccurrence[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId])
  @@index([targetUserId])
}

model HabitOccurrence {
  id        String                @id @default(cuid())
  habitId   String
  habit     Habit                 @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  status    HabitOccurrenceStatus @default(pending)
  entry     Entry?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([habitId, date])
}

model Goal {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  targetAmount Decimal    @db.Decimal(10, 2)
  emoji        String?
  targetUserId String?
  targetUser   User?      @relation("GoalTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
  @@index([targetUserId])
}

model Budget {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope       BudgetScope
  scopeKey    String
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  period      BudgetPeriod
  amount      Decimal      @db.Decimal(10, 2)
  currency    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, period, scope, scopeKey])
  @@index([workspaceId, period])
  @@index([workspaceId, categoryId])
}

model WorkspaceSettlement {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUserId      String
  fromUser        User      @relation("WorkspaceSettlementFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  toUser          User      @relation("WorkspaceSettlementToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(10, 2)
  date            DateTime
  note            String?
  createdByUserId String?
  createdBy       User?     @relation("WorkspaceSettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, fromUserId])
  @@index([workspaceId, toUserId])
  @@index([createdByUserId])
}

model ImportBatch {
  id                String               @id @default(cuid())
  workspaceId       String
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId    String
  createdBy         User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  source            ImportSource         @default(bank_csv)
  originalFilename  String?
  mimeType          String?
  fileSize          Int?
  delimiter         String?
  status            ImportBatchStatus    @default(parsing)
  headerRowJson     Json?
  columnMappingJson Json?
  rowCount          Int                  @default(0)
  parsedCount       Int                  @default(0)
  confirmedCount    Int                  @default(0)
  ignoredCount      Int                  @default(0)
  duplicateCount    Int                  @default(0)
  errorMessage      String?
  transactions      ImportedTransaction[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([workspaceId, status])
  @@index([createdByUserId])
  @@index([source])
}

model ImportedTransaction {
  id                String                    @id @default(cuid())
  workspaceId       String
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importBatchId     String
  importBatch       ImportBatch               @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  source            ImportSource              @default(bank_csv)
  sourceRowIndex    Int
  externalId        String?
  fingerprint       String
  date              DateTime?
  description       String
  merchantName      String?
  /// Sempre positivo. Il verso lo dice `flow`, non il segno.
  amount            Decimal?                  @db.Decimal(10, 2)
  currency          String?
  flow              ImportedTransactionFlow   @default(outgoing)
  status            ImportedTransactionStatus @default(pending)
  categoryIdSuggested String?
  categorySuggested Category?                 @relation("ImportedTransactionCategorySuggested", fields: [categoryIdSuggested], references: [id], onDelete: SetNull)
  categoryIdConfirmed String?
  categoryConfirmed Category?                 @relation("ImportedTransactionCategoryConfirmed", fields: [categoryIdConfirmed], references: [id], onDelete: SetNull)
  entryId           String?
  entry             Entry?                    @relation("ImportedTransactionEntry", fields: [entryId], references: [id], onDelete: SetNull)
  /// Il gemello di `entryId` per le righe in entrata: una riga importata
  /// diventa una spesa oppure un'entrata, mai tutte e due.
  incomeId          String?
  income            Income?                   @relation("ImportedTransactionIncome", fields: [incomeId], references: [id], onDelete: SetNull)
  /// Il terzo bersaglio. Nel CSV del conto personale il versamento sul
  /// cointestato e' un addebito: senza questa colonna diventerebbe una spesa,
  /// gonfiando le uscite del mese con soldi che non sono usciti di casa.
  transferId        String?
  transfer          Transfer?                 @relation("ImportedTransactionTransfer", fields: [transferId], references: [id], onDelete: SetNull)
  duplicateOfId     String?
  duplicateOf       ImportedTransaction?      @relation("ImportedTransactionDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicateTransactions ImportedTransaction[] @relation("ImportedTransactionDuplicate")
  rawJson           Json?
  errorMessage      String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([importBatchId, sourceRowIndex])
  @@index([workspaceId, source, fingerprint])
  @@index([workspaceId, status])
  @@index([entryId])
  @@index([incomeId])
  @@index([transferId])
  @@index([importBatchId])
}

model User {
  id                   String            @id
  email                String?           @unique
  name                 String?
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]
  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreatedBy")
  workspaceInvitesAccepted WorkspaceInvite[] @relation("WorkspaceInviteAcceptedBy")
  createdEntries       Entry[]             @relation("EntryCreatedBy")
  paidEntries          Entry[]             @relation("EntryPaidBy")
  beneficiaryEntries   EntryBeneficiary[]
  settlementsSent      WorkspaceSettlement[] @relation("WorkspaceSettlementFromUser")
  settlementsReceived  WorkspaceSettlement[] @relation("WorkspaceSettlementToUser")
  settlementsCreated   WorkspaceSettlement[] @relation("WorkspaceSettlementCreatedBy")
  targetHabits         Habit[]             @relation("HabitTargetUser")
  targetGoals          Goal[]              @relation("GoalTargetUser")
  feedbacks            Feedback[]          @relation("FeedbackUser")
  createdImportBatches ImportBatch[]
  incomesReceived      Income[]            @relation("IncomeReceivedBy")
  incomesCreated       Income[]            @relation("IncomeCreatedBy")
  transfersMade        Transfer[]          @relation("TransferUser")
  transfersCreated     Transfer[]          @relation("TransferCreatedBy")
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  kind         WorkspaceKind     @default(private)
  timezone       String            @default("Europe/Rome")
  currency       String            @default("EUR")
  language       String            @default("it")
  setupCompleted Boolean           @default(false)
  /// Il saldo del conto comune. Ha senso solo negli spazi condivisi, dove le
  /// spese segnate come cointestate escono da qui invece che dal conto di uno.
  jointBalanceStart     Decimal?  @db.Decimal(12, 2)
  jointBalanceStartDate DateTime?
  ownerUserId    String
  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  categories   Category[]
  budgets      Budget[]
  settlements  WorkspaceSettlement[]
  importBatches ImportBatch[]
  importedTransactions ImportedTransaction[]
  entries      Entry[]
  incomes      Income[]
  transfers    Transfer[]
  habits       Habit[]
  goals        Goal[]
  feedbacks    Feedback[]        @relation("FeedbackWorkspace")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerUserId])
}

/// Le entrate stanno fuori da Entry di proposito. Trentasei file e duecento
/// punti del codice leggono Entry e sommano realCost, e quasi nessuno filtra
/// per tipo: un'entrata dentro quella tabella verrebbe sommata come una spesa
/// finche' non si controllano tutti. Qui invece nessun calcolo esistente
/// cambia comportamento, perche' proprio non la vede.
model Income {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title            String
  amount           Decimal   @db.Decimal(10, 2)
  /// Mezzanotte del giorno nel fuso dello spazio, come per Entry.
  date             DateTime
  /// Chi l'ha incassata. Un'entrata arriva sempre su un conto personale: sul
  /// conto comune i soldi ci arrivano solo con un Transfer. Nullo qui non
  /// significa "comune", significa che quella persona non e' piu' nello
  /// spazio, e un'entrata orfana non entra in nessun saldo.
  receivedByUserId String?
  receivedByUser   User?     @relation("IncomeReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?     @relation("IncomeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  source           IncomeSource @default(manual)
  note             String?
  importedTransactions ImportedTransaction[] @relation("ImportedTransactionIncome")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, date])
  @@index([receivedByUserId])
  @@index([createdByUserId])
}

/// Un giroconto fra un conto personale e il cointestato. Non e' un'entrata: i
/// soldi non arrivano da fuori, si spostano dentro casa, quindi il totale
/// delle entrate del mese non lo vede. Non e' nemmeno un regolamento: quello
/// pareggia un debito fra due persone ed e' vincolato alla differenza, questo
/// muove la cifra che vuoi fra due conti.
model Transfer {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Chi muove i soldi. L'altro capo e' sempre il conto comune, per questo non
  /// c'e' una seconda colonna. Nullo significa persona non piu' nello spazio:
  /// il comune continua a vedere il movimento, nessun personale lo vede.
  userId          String?
  user            User?             @relation("TransferUser", fields: [userId], references: [id], onDelete: SetNull)
  direction       TransferDirection
  /// Sempre positivo: il verso lo dice direction, non il segno.
  amount          Decimal           @db.Decimal(10, 2)
  /// Mezzanotte del giorno nel fuso dello spazio, come per Entry e Income.
  date            DateTime
  note            String?
  createdByUserId String?
  createdBy       User?             @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  importedTransactions ImportedTransaction[] @relation("ImportedTransactionTransfer")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId, date])
  @@index([userId])
  @@index([createdByUserId])
}

model Feedback {
  id          String    @id @default(cuid())
  userId      String?
  workspaceId String?
  type        String
  message     String
  route       String?
  userAgent   String?
  viewport    String?
  timezone    String?
  locale      String?
  displayMode String?
  appVersion  String?
  createdAt   DateTime  @default(now())

  user      User?      @relation("FeedbackUser", fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation("FeedbackWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([type])
}

model RateLimitBucket {
  key          String    @id
  scope        String
  windowStart  DateTime  @default(now())
  count        Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([scope])
  @@index([blockedUntil])
  @@index([updatedAt])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(member)
  lastSelectedAt DateTime?
  /// Il saldo dichiarato da questa persona in questo spazio, e da quando vale.
  /// Nullo finche' non lo imposta: il saldo e' facoltativo, non un requisito.
  balanceStart     Decimal?  @db.Decimal(12, 2)
  balanceStartDate DateTime?
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([userId, lastSelectedAt])
}

model WorkspaceInvite {
  id                String     @id @default(cuid())
  tokenHash         String     @unique
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              WorkspaceInviteType @default(email)
  invitedEmail      String
  role              WorkspaceMemberRole @default(member)
  createdByUserId   String?
  createdBy         User?      @relation("WorkspaceInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedByUserId  String?
  acceptedBy        User?      @relation("WorkspaceInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt        DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime
  maxUses           Int        @default(1)
  usedCount         Int        @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([workspaceId])
  @@index([invitedEmail])
  @@index([expiresAt])
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, revokedAt])
}
