# Non l'ho comprato environment template
# Copy to .env.local for local development. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin access (server-side only, never NEXT_PUBLIC_).
# Comma-separated list of emails allowed to access /debug and other admin routes.
# In production, if unset, admin routes are blocked for everyone.
# In development, if unset, any authenticated user is allowed (convenience).
ADMIN_EMAILS="h.marian914@gmail.com"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=<supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required in production: without this key the /delete-account flow is blocked
# to prevent half-deleted accounts (app data gone, Supabase auth user still alive).
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Database (Prisma)
# Use the Supabase transaction pooler for runtime/serverless environments.
DATABASE_URL=<supabase-transaction-pooler-6543-url>?pgbouncer=true
# Use the direct connection for Prisma migrations and maintenance scripts.
DIRECT_URL=<supabase-session-pooler-5432-url>

# Production clone workflow. Use placeholders only here; never commit real URLs.
# PROD_DATABASE_URL is used only for read-only pg_dump from production.
PROD_DATABASE_URL=<old-production-readonly-url>
# LOCAL_DATABASE_URL must point to a local Postgres instance for restore/rehearsal.
LOCAL_DATABASE_URL=<local-postgres-url>

# Legacy migration bridge. Production is hard-blocked in code even if enabled.
ENABLE_LEGACY_FALLBACK=false
ENABLE_LEGACY_AUTH_BRIDGE=false
# LEGACY_WORKSPACE_ID=legacy-workspace
# LEGACY_PRIMARY_USER_ID=legacy-user-1
# LEGACY_SECONDARY_USER_ID=legacy-user-2
# LEGACY_PRIMARY_EMAIL=primary@example.com
# LEGACY_SECONDARY_EMAIL=secondary@example.com
# PRODUCTION_WORKSPACE_NAME=Workspace condiviso

# Diagnostics. Keep disabled unless debugging locally.
DEBUG_WORKSPACE=false
DEBUG_ENTRIES=false
DEBUG_ENTRY_LOAD=false
DEBUG_AUTH_PERFORMANCE=false
DEBUG_SUPABASE_PROXY=false

# Optional analytics
NEXT_PUBLIC_POSTHOG_ENABLED=false
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional Sentry
NEXT_PUBLIC_SENTRY_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Vercel metadata is injected by Vercel in deployed environments.
# VERCEL_ENV=development
