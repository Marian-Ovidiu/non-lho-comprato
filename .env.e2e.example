# Non l'ho comprato — E2E test environment template
# Copy to .env.e2e and fill in real test database credentials.
# Never use production credentials here. This file is committed; .env.e2e is gitignored.

# E2E guard — scripts refuse to run unless this exact value is present in .env.e2e
E2E_DATABASE_GUARD="non-lho-comprato-e2e"

# E2E auth bypass — enables the cookie-based test auth bridge (inactive in production)
E2E_TEST_AUTH_ENABLED="true"

# E2E server — Playwright and the dev server must agree on this port
NEXT_PUBLIC_APP_URL="http://localhost:3100"
E2E_BASE_URL="http://localhost:3100"
E2E_PORT="3100"

# Database — point to a disposable local test database, never to production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/non_lho_comprato_e2e"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/non_lho_comprato_e2e"

# Supabase Auth — the E2E auth bridge bypasses Supabase, so these can stay empty
# Fill in SUPABASE_SERVICE_ROLE_KEY only if you need to test the full delete-account flow.
# Server-only. Never create a NEXT_PUBLIC_ service-role key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Field encryption is disabled by default in E2E. Set both values only when
# explicitly testing encrypted-field behavior against a disposable database.
APP_FIELD_ENCRYPTION_KEY_ID=""
APP_FIELD_ENCRYPTION_KEY=""

# Analytics and error reporting — keep disabled in test environments
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
