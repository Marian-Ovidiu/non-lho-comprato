{
  "name": "non-lho-comprato",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prisma:validate": "prisma validate",
    "check": "npm run prisma:validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "backfill:multi-account": "tsx prisma/backfill-multi-account.ts",
    "verify:auth-provisioning": "tsx scripts/verify-auth-provisioning.ts",
    "audit:legacy-data": "tsx scripts/audit-legacy-data.ts",
    "repair:legacy-sharing": "tsx scripts/repair-legacy-sharing.ts",
    "migrate:goal-preset-person": "tsx scripts/migrate-goal-preset-person.ts",
    "release:archive": "sh -c 'mkdir -p release && out=release/non-lho-comprato-$(git rev-parse --short HEAD).zip && git archive --format=zip --output=\"$out\" --add-file=.env.example HEAD -- . \":(exclude).env\" \":(exclude).env.*\" \":(exclude).env-backup\" \":(exclude).env-backup/**\" \":(exclude)backups\" \":(exclude)backups/**\" \":(exclude)**/*.dump\" \":(exclude).git\" \":(exclude).idea\" \":(exclude).idea/**\" \":(exclude).claude\" \":(exclude).claude/**\" \":(exclude).agents\" \":(exclude).agents/**\" \":(exclude).next\" \":(exclude).next/**\" \":(exclude)node_modules\" \":(exclude)node_modules/**\" \":(exclude)__MACOSX\" \":(exclude)__MACOSX/**\" \":(exclude).DS_Store\" \":(exclude)**/.DS_Store\" \":(exclude)tsconfig.tsbuildinfo\" \":(exclude)**/*.tsbuildinfo\" \":(exclude)release\" \":(exclude)release/**\"'",
    "db:preflight:workspace": "psql \"$DATABASE_URL\" -f scripts/db/preflight-workspace.sql",
    "db:postflight:workspace": "psql \"$DATABASE_URL\" -f scripts/db/postflight-workspace.sql",
    "db:user-relink:diagnostics": "psql \"$DATABASE_URL\" -f scripts/db/user-relink-diagnostics.sql",
    "db:user-relink:new-supabase": "psql \"$DATABASE_URL\" -f scripts/db/user-relink-new-supabase.sql",
    "db:target": "node scripts/db/print-db-target.js DATABASE_URL",
    "db:target:prod": "node scripts/db/print-db-target.js PROD_DATABASE_URL",
    "db:target:local": "node scripts/db/print-db-target.js LOCAL_DATABASE_URL",
    "db:dump:prod": "scripts/db/dump-production-template.sh",
    "db:restore:local": "scripts/db/restore-local-template.sh",
    "db:preflight:auth-cutover": "psql \"$DATABASE_URL\" -f scripts/db/preflight-auth-email-cutover.sql",
    "db:repair:known-workspace-drift": "psql \"$DATABASE_URL\" -f scripts/db/repair-known-workspace-drift.sql",
    "db:repair:known-test-users": "psql \"$DATABASE_URL\" -f scripts/db/repair-known-test-users.sql"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/env": "16.2.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "posthog-js": "^1.373.4",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
